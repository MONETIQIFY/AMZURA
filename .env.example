# =====================================================================
# AMZURA — Environment variables
# Copy this file to `.env` for local dev, and add the SAME keys in
# Netlify under: Site settings → Environment variables.
# NEVER commit the real .env file. Keep these secret.
# =====================================================================

# ---- Stripe (https://dashboard.stripe.com/apikeys) -------------------
# Use test keys (prefix sk_test_ / pk_test_) while building, then swap to
# live keys (prefix sk_live_ / pk_live_) when you go live.
STRIPE_SECRET_KEY=REPLACE_WITH_YOUR_STRIPE_SECRET_KEY
STRIPE_PUBLISHABLE_KEY=REPLACE_WITH_YOUR_STRIPE_PUBLISHABLE_KEY

# The Stripe Price ID for the mentorship (Products → your product → Pricing).
# Looks like the prefix price_ followed by an id. Add more later for plans.
STRIPE_PRICE_ID=REPLACE_WITH_YOUR_STRIPE_PRICE_ID

# Webhook signing secret (Stripe → Developers → Webhooks → your endpoint).
# Looks like the prefix whsec_ followed by a long string.
STRIPE_WEBHOOK_SECRET=REPLACE_WITH_YOUR_STRIPE_WEBHOOK_SECRET

# ---- Google Sheets (service account) ---------------------------------
# See README "Google Sheet setup". Share the sheet with the service
# account email as an Editor.
GOOGLE_SHEET_ID=your_google_sheet_id_from_the_url
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-bot@your-project.iam.gserviceaccount.com
# Paste the full private key. Keep the \n as literal characters OR paste
# the multi-line key wrapped in quotes — the code handles both.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEv...\n-----END PRIVATE KEY-----\n"

# ---- Public site config (safe to expose) -----------------------------
# These are read by the browser via /assets/js/config.js indirectly and
# by functions. The Discord invite for "not in budget" leads:
PUBLIC_DISCORD_INVITE=https://discord.gg/your-invite
# Your Cal.com booking link (e.g. yourteam/strategy-call):
PUBLIC_CALCOM_LINK=yourteam/strategy-call
# The site's own base URL (used for Stripe success/cancel redirects):
URL=http://localhost:8888
